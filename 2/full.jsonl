            "output": "<path>/Users/itsmeyaw/projects/binden/src/lib/schema.ts</path>\n<type>file</type>\n<content>\n1: import { sql } from \"drizzle-orm\";\n2: import { pgTable, text, timestamp, uniqueIndex, uuid } from \"drizzle-orm/pg-core\";\n3: \n4: export const signupRequest = pgTable(\n5:   \"signup_request\",\n6:   {\n7:     id: uuid().defaultRandom().primaryKey(),\n8:     givenName: text(\"given_name\").notNull(),\n9:     familyName: text(\"family_name\").notNull(),\n10:     contactEmail: text(\"contact_email\").notNull(),\n11:     phone: text(),\n12:     connection: text(),\n13:     status: text().notNull().default(\"pending_verification\"),\n14:     verificationTokenHash: text(\"verification_token_hash\").notNull(),\n15:     verificationExpiresAt: timestamp(\"verification_expires_at\", { withTimezone: true }).notNull(),\n16:     createdAt: timestamp(\"created_at\", { withTimezone: true }).notNull().defaultNow(),\n17:   },\n18:   (table) => [\n19:     uniqueIndex(\"active_signup_request_contact_email_idx\")\n20:       .on(sql`lower(${table.contactEmail})`)\n21:       .where(\n22:         sql`${table.status} in ('pending_verification', 'verified', 'under_review', 'accepted', 'provisioning', 'awaiting_handover')`,\n23:       ),\n24:   ],\n25: );\n26: \n27: export const mailMessage = pgTable(\"mail_message\", {\n28:   id: uuid().defaultRandom().primaryKey(),\n29:   signupRequestId: uuid(\"signup_request_id\")\n30:     .notNull()\n31:     .references(() => signupRequest.id, { onDelete: \"cascade\" }),\n32:   to: text().notNull(),\n33:   subject: text().notNull(),\n34:   text: text().notNull(),\n35:   createdAt: timestamp(\"created_at\", { withTimezone: true }).notNull().defaultNow(),\n36: });\n\n(End of file - total 36 lines)\n</content>",
